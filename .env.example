# ============================================
# Sodrujestvo HotoSho
# Environment Configuration
# ============================================

# Public canonical origin
NEXT_PUBLIC_SITE_URL=https://hotosho.ru

# ============================================
# PostgreSQL
# ============================================

# Password for local Docker Compose PostgreSQL.
# Replace this example value in your local .env.
POSTGRES_PASSWORD=replace_with_strong_local_password

# Prisma connection to local PostgreSQL.
# The password must match POSTGRES_PASSWORD.
# Local PostgreSQL is exposed on port 5433.
DATABASE_URL="postgresql://sodrujestvo:replace_with_strong_local_password@localhost:5433/sodrujestvo"

# ============================================
# Security
# ============================================

# Never commit real credentials, tokens or secrets.
# Keep actual values only in the ignored .env file.