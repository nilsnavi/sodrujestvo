# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
logs/
*.log

# caches
.turbo/
.swc/
.cache/
.eslintcache
.stylelintcache
.parcel-cache
.npm/

# editors / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.fleet/
.qoder/
*.swp
*.swo
*~

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# build artefacts / temp
dist/
tmp/
temp/
*.local

# package manager lock conflicts (keep your own)
# yarn.lock
# pnpm-lock.yaml

# storybook
storybook-static/

# sentry
.sentryclirc

/src/generated/prisma